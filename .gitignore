
# ==========================================
# SISTEMA ROSETAS - .gitignore
# ==========================================

# 1. VARIAVEIS DE AMBIENTE
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!**/env.example

# 2. FIREBASE - CREDENCIAIS PRIVADAS
*-firebase-adminsdk-*.json
**/serviceAccountKey.json
**/firebase-service-account.json
**/firebase-adminsdk.json
**/secrets/
*.pem
*.key

# 3. JAVA / SPRING BOOT / MAVEN
**/target/
*.class
*.jar
*.war
*.ear
.mvn/timing.properties

# 4. NODE.JS / REACT / VITE
**/node_modules/
**/dist/
**/build/
**/.vite/
**/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. IDE / EDITORES
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
.factorypath

# 6. SISTEMA OPERACIONAL
.DS_Store
Thumbs.db
desktop.ini
*~

# 7. LOGS E ARQUIVOS TEMPORARIOS
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp

# 8. BANCO DE DADOS E BACKUPS
*.sql.gz
*.dump
*.backup
pgdata/
postgres-data/

# 9. DOCKER - ARQUIVOS LOCAIS
docker-compose.override.yml

# 10. ARQUIVOS COMPACTADOS
*.zip
*.rar
*.7z
