# Copie para ../.env (mesma pasta do docker-compose.prod.yml) e preencha. NUNCA versione o .env.

# Domínios (os dois precisam apontar para o IP do servidor no DNS)
SITE_DOMAIN=escarapela.com.br
ERP_DOMAIN=gestao.escarapela.com.br

BRAND_NAME=Escarapela

# Senhas longas e aleatórias (ex.: openssl rand -hex 24)
DB_PASSWORD=
WEBHOOK_SECRET=

# Firebase > Configurações do projeto > Geral > Seus apps > Web
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
